mode "mouse" {
    # === MOVEMENT ===
    # Fine movement (10px) - precision positioning
    bindsym h exec --no-startup-id xdotool mousemove_relative -- -10 0
    bindsym j exec --no-startup-id xdotool mousemove_relative -- 0 10
    bindsym k exec --no-startup-id xdotool mousemove_relative -- 0 -10
    bindsym l exec --no-startup-id xdotool mousemove_relative -- 10 0

    # Medium movement (50px) - normal navigation
    bindsym Shift+h exec --no-startup-id xdotool mousemove_relative -- -50 0
    bindsym Shift+j exec --no-startup-id xdotool mousemove_relative -- 0 50
    bindsym Shift+k exec --no-startup-id xdotool mousemove_relative -- 0 -50
    bindsym Shift+l exec --no-startup-id xdotool mousemove_relative -- 50 0

    # Jump movement (half screen) - quick large jumps
    bindsym Mod1+h exec --no-startup-id ~/.config/i3/mouse-helper.sh jump-left
    bindsym Mod1+j exec --no-startup-id ~/.config/i3/mouse-helper.sh jump-down
    bindsym Mod1+k exec --no-startup-id ~/.config/i3/mouse-helper.sh jump-up
    bindsym Mod1+l exec --no-startup-id ~/.config/i3/mouse-helper.sh jump-right

    # === CLICKS ===
    bindsym a exec --no-startup-id xdotool click 1   # left click
    bindsym s exec --no-startup-id xdotool click 3   # right click
    bindsym m exec --no-startup-id xdotool click 2   # middle click
    bindsym w exec --no-startup-id xdotool click --repeat 2 --delay 100 1   # double click

    # === NAVIGATION BUTTONS ===
    bindsym e exec --no-startup-id xdotool click 8   # back (button 4)
    bindsym t exec --no-startup-id xdotool click 9   # forward (button 5)

    # === SCROLLING ===
    # Vertical scrolling
    bindsym u exec --no-startup-id xdotool click 4   # scroll up
    bindsym d exec --no-startup-id xdotool click 5   # scroll down

    # Horizontal scrolling
    bindsym Shift+u exec --no-startup-id xdotool click 6   # scroll left
    bindsym Shift+d exec --no-startup-id xdotool click 7   # scroll right

    # === DRAG OPERATIONS ===
    bindsym Shift+a exec --no-startup-id xdotool mousedown 1   # left drag start
    bindsym Shift+s exec --no-startup-id xdotool mousedown 3   # right drag start
    bindsym r exec --no-startup-id xdotool mouseup 1 mouseup 2 mouseup 3   # release all drags

    # === POSITION JUMPS ===
    # Jump to center of focused window
    bindsym c exec --no-startup-id ~/.config/i3/mouse-helper.sh window-center

    # Jump to center of screen
    bindsym 0 exec --no-startup-id ~/.config/i3/mouse-helper.sh screen-center

    # === PASSTHROUGH: Window focus ===
    bindsym $mod+h focus left
    bindsym $mod+j focus down
    bindsym $mod+k focus up
    bindsym $mod+l focus right

    # === PASSTHROUGH: Workspace switching ===
    bindsym $mod+1 workspace number $ws1
    bindsym $mod+2 workspace number $ws2
    bindsym $mod+3 workspace number $ws3
    bindsym $mod+4 workspace number $ws4
    bindsym $mod+5 workspace number $ws5
    bindsym $mod+6 workspace number $ws6
    bindsym $mod+7 workspace number $ws7
    bindsym $mod+8 workspace number $ws8
    bindsym $mod+9 workspace number $ws9

    # === PASSTHROUGH: Common actions ===
    bindsym $mod+q kill
    bindsym $mod+Shift+space floating toggle
    bindsym $mod+space exec --no-startup-id rofi -show combi

    # === EXIT MOUSE MODE ===
    bindsym q mode "default"
    bindsym Escape mode "default"
}

# keybinding to enter mouse mode
bindsym $mod+m mode "mouse"


